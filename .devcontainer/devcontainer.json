{
  "name": "ARTEMIS + Android Emulator 1-Click Codespace",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Artemis Web Console",
      "onAutoForward": "openBrowserOnce",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash scripts/setup-1click.sh",
  "postStartCommand": "bash scripts/start-all.sh"
}
